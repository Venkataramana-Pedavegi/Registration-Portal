# ===================================================================
# Frontend Client Environment Configuration (Vercel / Local)
# ===================================================================

# Production Backend API URL:
# Configure this in your Vercel Project Settings > Environment Variables.
# Both formats (with or without /api suffix) are automatically supported.
#
# Examples:
#   Local development:   http://localhost:5000/api
#   Railway Production:  https://YOUR-RAILWAY-DOMAIN.up.railway.app/api
VITE_API_URL=http://localhost:5000/api

# Real-Time Socket.IO Server URL (Optional):
# If omitted, automatically defaults to the base origin of VITE_API_URL.
#
# Examples:
#   Local development:   http://localhost:5000
#   Railway Production:  https://YOUR-RAILWAY-DOMAIN.up.railway.app
VITE_SOCKET_URL=http://localhost:5000
