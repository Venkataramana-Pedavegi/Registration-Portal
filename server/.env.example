PORT=5000
NODE_ENV=production

# Frontend Client Origin (Allowed in CORS)
FRONTEND_URL=https://registration-portal-6is5nnjtd-ramanas-projects-c89ec6d9.vercel.app

# MySQL Database (In Railway, either DB_* or MYSQL* variables or MYSQL_URL are provided)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=college_event_registration
DB_USER=root
DB_PASSWORD=yourpassword

# JWT Authentication & Session Refresh
JWT_SECRET=supersecretkeychangethisinproduction
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=superrefreshsecretchangethisinproduction

# Google Gemini AI Integration (Required for AI assistant, recommendation, & smart search features)
# Generate a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Email Notifications (Gmail App Password or Custom SMTP)
# For Gmail, generate a 16-character App Password at: https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-16-char-app-password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_SECURE=false

# Optional: set to 'true' to allow students to log in without email verification
DISABLE_EMAIL_VERIFICATION=false
DB_SSL=false
